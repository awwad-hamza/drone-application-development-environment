#!/usr/bin/env bash
set -euo pipefail

repo=/workspaces/x650-autonomy
log_dir="$repo/.sitl-gazebo"
mkdir -p "$log_dir"
pids=()
setup_pid=''

cleanup() {
    trap - EXIT INT TERM
    if [[ -n "$setup_pid" ]]; then
        kill "$setup_pid" 2>/dev/null || true
    fi
    for pid in "${pids[@]}"; do
        kill "$pid" 2>/dev/null || true
    done
    wait || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

start-mavros > "$log_dir/mavros.log" 2>&1 &
pids+=("$!")
start-gazebo > "$log_dir/gazebo.log" 2>&1 &
pids+=("$!")
start-sitl > "$log_dir/sitl.log" 2>&1 &
pids+=("$!")

echo 'Launching Gazebo + SITL + MAVROS.'
echo 'Waiting for SITL and configuring the RC mode switch automatically...'

python3 "$repo/scripts/configure_sim_modes.py" \
    > "$log_dir/mode_setup.log" 2>&1 &
setup_pid=$!

status=0
finished=''
wait -n -p finished "${pids[@]}" "$setup_pid" || status=$?

if [[ "${finished:-}" != "$setup_pid" ]]; then
    echo "A simulation process exited during setup (status $status)." >&2
    echo "Inspect $log_dir/{gazebo,sitl,mavros,mode_setup}.log" >&2
    exit 1
fi

setup_pid=''
if (( status != 0 )); then
    echo 'Automatic mode setup failed; stopping the simulation.' >&2
    tail -n 40 "$log_dir/mode_setup.log" >&2
    exit "$status"
fi

echo 'RC safety configured: 1=GUIDED, 2=ALT_HOLD, hold SPACE=motor stop.'
echo 'Wait for GPS/EKF initialization before flight commands.'
echo "Logs: $log_dir/{gazebo,sitl,mavros,mode_setup}.log"
echo 'Press Ctrl+C to stop everything.'

status=0
wait -n "${pids[@]}" || status=$?
echo "A simulation process exited (status $status); stopping the others." >&2
exit "$status"
